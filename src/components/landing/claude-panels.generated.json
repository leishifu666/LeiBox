{
  "discovery": {
    "className": "lb-showcase lb-panel lb-discovery",
    "html": "\n  <div class=\"lb-stage\">\n    <!-- Step 1 -->\n    <div class=\"lb-layer is-active\" data-lb-layer=\"0\">\n      <div class=\"lb-source-header\">\n        <h3 class=\"lb-title-lg\" data-i18n=\"d.s1Title\">组件收藏</h3>\n        <p class=\"lb-text-muted\" data-i18n=\"d.s1Desc\">搜索组件、动效与交互</p>\n      </div>\n      <div class=\"lb-gallery\">\n        <div class=\"lb-card\" data-slug=\"glass-folder\">\n          <div class=\"lb-media\"><img src=\"/assets/components/glass-folder.png\" alt=\"\" loading=\"lazy\"></div>\n          <div class=\"lb-card__info\">\n            <span class=\"lb-card__name\" data-i18n=\"c.glass-folder\">玻璃文件夹</span>\n            <span class=\"lb-card__check\"><span data-lb-icon=\"Check\"></span></span>\n          </div>\n        </div>\n        <div class=\"lb-card\" data-slug=\"dot-matrix-trio\">\n          <div class=\"lb-media\"><img src=\"/assets/components/dot-matrix-trio.png\" alt=\"\" loading=\"lazy\"></div>\n          <div class=\"lb-card__info\">\n            <span class=\"lb-card__name\" data-i18n=\"c.dot-matrix-trio\">点阵波纹与旋涡</span>\n            <span class=\"lb-card__check\"><span data-lb-icon=\"Check\"></span></span>\n          </div>\n        </div>\n        <div class=\"lb-card\" data-slug=\"brand-poster-cards\">\n          <div class=\"lb-media\"><img src=\"/assets/components/brand-poster-cards.png\" alt=\"\" loading=\"lazy\"></div>\n          <div class=\"lb-card__info\">\n            <span class=\"lb-card__name\" data-i18n=\"c.brand-poster-cards\">品牌海报三联卡片</span>\n            <span class=\"lb-card__check\"><span data-lb-icon=\"Check\"></span></span>\n          </div>\n        </div>\n        <div class=\"lb-card\" data-slug=\"soft-action-wheel\">\n          <div class=\"lb-media\"><img src=\"/assets/components/soft-action-wheel.png\" alt=\"\" loading=\"lazy\"></div>\n          <div class=\"lb-card__info\">\n            <span class=\"lb-card__name\" data-i18n=\"c.soft-action-wheel\">柔光环形菜单</span>\n            <span class=\"lb-card__check\"><span data-lb-icon=\"Check\"></span></span>\n          </div>\n        </div>\n      </div>\n      <img src=\"/landing/agent-demo/cursors/default.svg\" class=\"lb-cursor-img\" alt=\"\" aria-hidden=\"true\">\n    </div>\n\n    <!-- Step 2 -->\n    <div class=\"lb-layer\" data-lb-layer=\"1\">\n      <div class=\"lb-source-layout\">\n        <div class=\"lb-source-header\">\n          <h3 class=\"lb-title-lg\" data-i18n=\"d.s2Title\">来源与许可</h3>\n          <p class=\"lb-text-muted\" data-i18n=\"d.s2Desc\">追溯原始设计与源码构成</p>\n        </div>\n        <div class=\"lb-source-hero\"><img src=\"/assets/components/glass-folder.png\" alt=\"\"></div>\n        <div class=\"lb-source-meta\">\n          <h4 class=\"lb-title-md\">GlassFolder</h4>\n          <p class=\"lb-text-muted\" data-i18n=\"d.desc\">磨砂玻璃文件夹，点击展开真实文件卡片，支持添加文件和键盘菜单。</p>\n          <div class=\"lb-meta-grid\">\n            <span class=\"lb-meta-label\" data-i18n=\"d.source\">来源</span>\n            <span class=\"lb-meta-value\" data-i18n=\"d.sourceVal\">用户提供的 React 源码，已在本项目适配</span>\n            <span class=\"lb-meta-label\" data-i18n=\"d.license\">许可</span>\n            <span class=\"lb-meta-value\" data-i18n=\"d.licenseVal\">以条目中的来源与许可说明为准</span>\n            <span class=\"lb-meta-label\" data-i18n=\"d.files\">源码</span>\n            <span class=\"lb-meta-value\" data-lb-files-info>React 版 <code>4</code> 个文件 · <code>673</code> 行</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Step 3 -->\n    <div class=\"lb-layer\" data-lb-layer=\"2\">\n       <div class=\"lb-preview-layout\">\n         <div class=\"lb-preview-header\">\n           <div>\n             <h3 class=\"lb-title-lg\" data-i18n=\"d.s3Title\">应用预览</h3>\n             <p class=\"lb-text-muted\" data-i18n=\"d.s3Desc\">真实运行演示</p>\n           </div>\n           <a href=\"/motion/glass-folder.html\" target=\"_blank\" class=\"lb-link-btn\" rel=\"noopener\">\n             <span data-i18n=\"d.openDemo\">独立演示</span> <span data-lb-icon=\"ExternalLink\"></span>\n           </a>\n         </div>\n         <div class=\"lb-preview-container\">\n           <iframe class=\"lb-preview-frame\" data-src=\"/motion/glass-folder.html\" title=\"Preview\" aria-hidden=\"true\" tabindex=\"-1\" loading=\"lazy\"></iframe>\n           <img src=\"/assets/components/glass-folder.png\" class=\"lb-preview-fallback\" alt=\"\">\n         </div>\n       </div>\n    </div>\n  </div>\n  \n  <div class=\"lb-discovery-foot\">\n    <div class=\"lb-mini-steps\" aria-hidden=\"true\">\n      <div class=\"lb-mini-step is-active\"></div><div class=\"lb-mini-step\"></div><div class=\"lb-mini-step\"></div>\n    </div>\n    <button type=\"button\" class=\"lb-btn lb-btn--icon lb-btn--ghost lb-play-ctrl\" data-lb-action=\"toggle-play\" data-playing=\"true\" aria-label=\"Pause\">\n      <span class=\"lb-ico-pause\" data-lb-icon=\"Pause\"></span>\n      <span class=\"lb-ico-play\" data-lb-icon=\"Play\"></span>\n    </button>\n  </div>\n"
  },
  "frameworks": {
    "className": "lb-showcase lb-panel lb-frameworks",
    "html": "\n  <div class=\"lb-fw-header\">\n    <div>\n      <h3 class=\"lb-title-lg\" data-i18n=\"f.title\">组件源码</h3>\n      <div class=\"lb-fw-meta\">\n        <span><span data-lb-icon=\"FileCode2\"></span> <span data-lb-files-count data-i18n=\"f.filesCount\">4 个文件</span></span>\n        <span><span data-lb-icon=\"Code2\"></span> <span data-lb-lines-count data-i18n=\"f.linesCount\">673 行</span></span>\n      </div>\n    </div>\n    <button type=\"button\" class=\"lb-btn\" data-lb-action=\"copy-code\">\n      <span class=\"lb-swap-idle\" data-lb-icon=\"Copy\"></span>\n      <span class=\"lb-swap-done\" data-lb-icon=\"Check\"></span>\n      <span data-lb-label=\"f.copy\" data-i18n=\"f.copy\">复制代码</span>\n    </button>\n  </div>\n\n  <div class=\"lb-fw-tabs-wrap\">\n    <div class=\"lb-fw-tabs\" role=\"tablist\">\n      <button type=\"button\" class=\"lb-fw-tab\" role=\"tab\" aria-selected=\"true\" data-fw=\"react\">React</button>\n      <button type=\"button\" class=\"lb-fw-tab\" role=\"tab\" aria-selected=\"false\" data-fw=\"vue\" tabindex=\"-1\">Vue</button>\n      <button type=\"button\" class=\"lb-fw-tab\" role=\"tab\" aria-selected=\"false\" data-fw=\"svelte\" tabindex=\"-1\">Svelte</button>\n      <button type=\"button\" class=\"lb-fw-tab\" role=\"tab\" aria-selected=\"false\" data-fw=\"solid\" tabindex=\"-1\">Solid</button>\n      <button type=\"button\" class=\"lb-fw-tab\" role=\"tab\" aria-selected=\"false\" data-fw=\"preact\" tabindex=\"-1\">Preact</button>\n      <button type=\"button\" class=\"lb-fw-tab\" role=\"tab\" aria-selected=\"false\" data-fw=\"vanilla\" tabindex=\"-1\">Vanilla</button>\n      <div class=\"lb-fw-ink\"></div>\n    </div>\n  </div>\n\n  <div class=\"lb-fw-content\">\n    <div class=\"lb-install-cmd\" data-lb-install>npm install react react-dom</div>\n    <div class=\"lb-code-viewer\"><code data-lb-code><span class=\"tk-k\">import</span> { GlassFolder } <span class=\"tk-k\">from</span> <span class=\"tk-s\">\"./GlassFolder\"</span>;\n\n<span class=\"tk-k\">export</span> <span class=\"tk-k\">default</span> <span class=\"tk-k\">function</span> App() {\n  <span class=\"tk-k\">return</span> &lt;<span class=\"tk-t\">GlassFolder</span> /&gt;;\n}</code></div>\n  </div>\n"
  },
  "agent": {
    "className": "lb-showcase lb-panel",
    "html": "\n  <div class=\"lb-agent-wrap\">\n    <div>\n      <div class=\"lb-agent-prompt\" data-lb-prompt>将 LeiBox 的 GlassFolder 玻璃文件夹组件集成到这个项目中。</div>\n    </div>\n    \n    <div class=\"lb-flow\">\n      <div class=\"lb-flow-item\" data-state=\"pending\">\n        <div class=\"lb-flow-icon\"><span data-lb-icon=\"Check\"></span></div>\n        <div class=\"lb-flow-content\">\n          <div class=\"lb-flow-title\" data-i18n=\"a.s1\">读取组件源码</div>\n          <div class=\"lb-flow-desc\" data-i18n=\"a.s1desc\">4 个文件 · 673 行</div>\n        </div>\n      </div>\n      <div class=\"lb-flow-item\" data-state=\"pending\">\n        <div class=\"lb-flow-icon\"><span data-lb-icon=\"Check\"></span></div>\n        <div class=\"lb-flow-content\">\n          <div class=\"lb-flow-title\" data-i18n=\"a.s2\">确认框架</div>\n          <div class=\"lb-flow-desc\">React</div>\n        </div>\n      </div>\n      <div class=\"lb-flow-item\" data-state=\"pending\">\n        <div class=\"lb-flow-icon\"><span data-lb-icon=\"Check\"></span></div>\n        <div class=\"lb-flow-content\">\n          <div class=\"lb-flow-title\" data-i18n=\"a.s3\">添加到项目</div>\n          <div class=\"lb-flow-desc\" data-i18n=\"a.s3desc\">提供用法示例</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"lb-agent-result\" data-lb-result>\n      <div class=\"lb-media\"><img src=\"/assets/components/glass-folder.png\" alt=\"\"></div>\n      <div class=\"lb-agent-result-text\">\n        <div class=\"lb-agent-result-name\">GlassFolder</div>\n        <div class=\"lb-agent-result-meta\" data-i18n=\"a.doneMeta\">演示完成 · 仅供示意</div>\n      </div>\n      <a href=\"/docs/animations/glass-folder\" class=\"lb-link-btn\" style=\"margin-left:auto;\">\n        <span data-lb-icon=\"ArrowUpRight\"></span>\n      </a>\n    </div>\n\n    <div class=\"lb-agent-actions\">\n       <button type=\"button\" class=\"lb-btn lb-btn--ghost\" data-lb-action=\"copy-prompt\">\n         <span class=\"lb-swap-idle\" data-lb-icon=\"Copy\"></span>\n         <span class=\"lb-swap-done\" data-lb-icon=\"Check\"></span>\n         <span data-lb-label=\"a.copyPrompt\" data-i18n=\"a.copyPrompt\">复制提示词</span>\n       </button>\n       <button type=\"button\" class=\"lb-btn lb-btn--icon lb-btn--ghost\" data-lb-action=\"replay\" aria-label=\"Replay\">\n         <span data-lb-icon=\"RotateCcw\"></span>\n       </button>\n    </div>\n  </div>\n"
  }
}
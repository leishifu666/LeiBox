[Unit]
Description=Expire unused LeiBox build assets and release backups

[Service]
Type=oneshot
# Root is required for assets retained from older publishers with root-owned directories.
WorkingDirectory=/opt/ProJect/leibox
ExecStart=/usr/bin/python3 /opt/ProJect/leibox/scripts/leibox-release-cleanup.py --root /opt/ProJect/leibox --apply
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ProJect/leibox

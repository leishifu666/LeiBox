{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeiBox task-oriented component search index",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "revision", "total", "links", "facets", "items"],
  "properties": {
    "$schema": { "const": "/ai/search-index.schema.json" },
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "total": { "type": "integer", "minimum": 0 },
    "links": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog", "guide", "skill"],
      "properties": { "catalog": { "$ref": "#/definitions/path" }, "guide": { "$ref": "#/definitions/path" }, "skill": { "$ref": "#/definitions/path" } }
    },
    "facets": {
      "type": "object", "additionalProperties": false,
      "required": ["categories", "frameworks", "visualTags"],
      "properties": { "categories": { "$ref": "#/definitions/counts" }, "frameworks": { "$ref": "#/definitions/counts" }, "visualTags": { "$ref": "#/definitions/counts" } }
    },
    "items": { "type": "array", "items": { "$ref": "#/definitions/component" } }
  },
  "definitions": {
    "path": { "type": "string", "pattern": "^/" },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["slug", "name", "summary", "frameworks", "renderers", "docsPath", "detailPath", "previewPath", "sourceProvider", "discovery"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "name": {
          "type": "object", "additionalProperties": false, "required": ["en", "zh"],
          "properties": { "en": { "type": "string", "minLength": 1 }, "zh": { "type": "string", "minLength": 1 } }
        },
        "summary": { "type": "string", "minLength": 1 },
        "frameworks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["react", "vue", "svelte", "solid", "preact", "vanilla"] } },
        "renderers": { "type": "array", "uniqueItems": true, "items": { "enum": ["webgl", "webgpu"] } },
        "docsPath": { "$ref": "#/definitions/path" },
        "detailPath": { "$ref": "#/definitions/path" },
        "previewPath": { "$ref": "#/definitions/path" },
        "sourceProvider": { "enum": ["leibox", "upstream"] },
        "discovery": {
          "type": "object", "additionalProperties": false,
          "required": ["category", "useCases", "searchTerms", "visualTags", "interactions", "caveat"],
          "properties": {
            "category": { "enum": ["hero", "cursor", "background", "scroll", "layout", "cards", "text", "input", "navigation", "data", "feedback", "files", "collaboration", "media"] },
            "useCases": { "$ref": "#/definitions/strings" },
            "searchTerms": { "$ref": "#/definitions/strings" },
            "visualTags": { "$ref": "#/definitions/strings" },
            "interactions": { "$ref": "#/definitions/strings" },
            "caveat": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}

# Build-time public values (Next.js inlines anything prefixed NEXT_PUBLIC_).
# Copy to .env.production.local for deploys, or .env.local for development.
# In production builds .env.production.local wins over .env.local, so the real
# key ships even though the test key stays in place for `next dev`.

# Cloudflare Turnstile site key for the newsletter signup.
# Required when wrangler.jsonc sets TURNSTILE_ENABLED="true".
# Local development can use the Cloudflare test key 1x00000000000000000000AA,
# but the deploy preflight rejects test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# html-in-canvas origin trial token, bound to the production origin.
NEXT_PUBLIC_HTML_IN_CANVAS_OT_TOKEN=

# Public deployment origin for metadata and AI reference links (optional locally).
NEXT_PUBLIC_SITE_URL=

# Contact form: server-only values. Never prefix these with NEXT_PUBLIC_.
# Local `npm start` reads .env.local. A verified sender is required in Resend.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=leir0491@gmail.com

# ---------------------------------------------------------------------------
# Worker secrets (NOT build-time). Set these with wrangler, never in a file:
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put CONTACT_FROM
# CONTACT_TO is optional; the contact form defaults to leir0491@gmail.com.
#   npx wrangler secret put TURNSTILE_SECRET_KEY
# For local `wrangler dev`, put the same keys in .dev.vars (gitignored).
# ---------------------------------------------------------------------------

[
  {
    "index": 0,
    "text": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>LeiBox Logo 探索</title>\n<style>\n  :root {\n    --ink: #111111;\n    --muted: #6b6b6b;\n    --line: #e4e4e4;\n    --card: #ffffff;\n    --ok: #1a7f37;\n    --bad: #c62828;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Segoe UI\", sans-serif;\n    color: var(--ink);\n    background: #fafafa;\n    line-height: 1.5;\n    font-size: 14px;\n  }\n  header {\n    max-width: 1180px;\n    margin: 0 auto;\n    padding: 28px 20px 8px;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px 24px;\n    align-items: flex-end;\n    justify-content: space-between;\n  }\n  h1 { font-size: 20px; margin: 0 0 4px; font-weight: 650; letter-spacing: .01em; }\n  .sub { margin: 0; color: var(--muted); font-size: 13px; }\n  .status { font-size: 13px; font-weight: 600; }\n  .status.ok { color: var(--ok); }\n  .status.bad { color: var(--bad); }\n  .toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n  .toolbar-label { color: var(--muted); font-size: 13px; margin-right: 2px; }\n  button {\n    font: inherit;\n    font-size: 13px;\n    color: var(--ink);\n    background: #fff;\n    border: 1px solid #cfcfcf;\n    border-radius: 8px;\n    padding: 6px 12px;\n    cursor: pointer;\n    min-height: 32px;\n  }\n  button:hover { border-color: #888; }\n  button:focus-visible { outline: 2px solid #2f6fed; outline-offset: 2px; }\n  button[aria-pressed=\"true\"] { background: var(--ink); color: #fff; border-color: var(--ink); }\n  main {\n    max-width: 1180px;\n    margin: 0 auto;\n    padding: 12px 20px 40px;\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n    gap: 16px;\n  }\n  .card {\n    background: var(--card);\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    min-width: 0;\n  }\n  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }\n  .card h2 { font-size: 15px; margin: 0; font-weight: 650; }\n  .idx { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 12px; }\n  .spec { color: var(--muted); font-size: 12px; margin: 0; }\n  .stage {\n    border-radius: 10px;\n    display: grid;\n    place-items: center;\n    padding: 18px 12px;\n    border: 1px solid var(--line);\n  }\n  .stage svg { display: block; }\n  .main-preview svg { width: 160px; height: 160px; }\n  .sizes {\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n    gap: 18px;\n    flex-wrap: wrap;\n  }\n  .size { display: flex; flex-direction: column; align-items: center; gap: 4px; }\n  .size span { font-size: 11px; color: var(--muted); }\n  .bg-dark .size span { color: #c9cfdc; }\n  .measure {\n    font-size: 12px;\n    font-variant-numeric: tabular-nums;\n    margin: 0;\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 2px 10px;\n  }\n  .measure dt { color: var(--muted); }\n  .measure dd { margin: 0; text-align: right; }\n  .check { font-size: 12px; font-weight: 600; }\n  .check.ok { color: var(--ok); }\n  .check.bad { color: var(--bad); }\n  .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }\n\n  /* 预览背景 */\n  .bg-white .stage { background: #ffffff; }\n  .bg-gray .stage { background: #ececec; }\n  .bg-dark .stage { background: #1f2a44; border-color: #1f2a44; }\n  .bg-checker .stage {\n    background-color: #ffffff;\n    background-image: conic-gradient(#d9d9d9 25%, #ffffff 0 50%, #d9d9d9 0 75%, #ffffff 0);\n    background-size: 16px 16px;\n  }\n\n  @media (max-width: 420px) {\n    header { padding: 20px 14px 4px; }\n    main { padding: 10px 14px 32px; grid-template-columns: 1fr; }\n    .main-preview svg { width: 140px; height: 140px; }\n    .sizes { gap: 12px; }\n  }\n</style>\n</head>\n<body class=\"bg-white\">\n<header>\n  <div>\n    <h1>LeiBox Logo 探索</h1>\n    <p class=\"sub\">黑色圆角盒 + 镂空折角 L · 两臂等长等粗 · 斜臂 −30°</p>\n    <p class=\"status\" id=\"globalStatus\" aria-live=\"polite\">校验中…</p>\n  </div>\n  <div class=\"toolbar\" role=\"group\" aria-label=\"预览背景\">\n    <span class=\"toolbar-label\">背景</span>\n    <button type=\"button\" data-bg=\"white\" aria-pressed=\"true\">白色</button>\n    <button type=\"button\" data-bg=\"gray\" aria-pressed=\"false\">浅灰</button>\n    <button type=\"button\" data-bg=\"dark\" aria-pressed=\"false\">深色</button>\n    <button type=\"button\" data-bg=\"checker\" aria-pressed=\"false\">透明格</button>\n  </div>\n</header>\n\n<main id=\"grid\" aria-label=\"Logo 方案\"></main>\n\n<script>\n(function () {\n  'use strict';\n\n  /* ---------- 共享参数 ---------- */\n  var SHELL = { cx: 256, cy: 256, R: 222, radius: 88 };   // 外壳：尖顶六边形外接圆半径 R，共享圆角半径\n  var BASE = {\n    elbow: { x: 282, y: 388 },   // L 的转折点\n    angleDeg: -30,               // 斜臂方向（屏幕坐标，y 向下）\n    canvas: 512,                 // viewBox 边长（以外壳中心居中）\n    minClearance: 12             // L 外轮廓距外壳边缘的最小距离\n  };\n  var VARIANTS = [\n    { key: '01-balanced', name: '均衡圆角', strokeWidth: 54, length: 140, cap: 'round', join: 'round' },\n    { key: '02-flat',     name: '平切端头', strokeWidth: 54, length: 140, cap: 'butt',  join: 'round' },\n    { key: '03-bold',     name: '厚实圆角', strokeWidth: 66, length: 132, cap: 'round', join: 'round' },\n    { key: '04-thin',     name: '纤细圆角', strokeWidth: 38, length: 148, cap: 'round', join: 'round' },\n    { key: '05-sharp',    name: '尖角折箭', strokeWidth: 54, length: 140, cap: 'butt',  join: 'miter' },\n    { key: '06-compact',  name: '紧凑版',   strokeWidth: 58, length: 128, cap: 'round', join: 'round', canvas: 440 }\n  ];\n  var CAP_LABEL = { round: '圆端', butt: '平切' };\n  var JOIN_LABEL = { round: '圆转角', miter: '尖转角' };\n  var EPS = 1e-6;\n\n  /* ---------- 基础几何 ---------- */\n  function f(n) { return (Math.round(n * 1000) / 1000).toString(); }\n  function sub(a, b) { return { x: a.x - b.x, y: a.y - b.y }; }\n  function add(a, b) { return { x: a.x + b.x, y: a.y + b.y }; }\n  function mul(a, k) { return { x: a.x * k, y: a.y * k }; }\n  function len(a) { return Math.hypot(a.x, a.y); }\n  function unit(a) { var l = len(a); return { x: a.x / l, y: a.y / l }; }\n  function dist(a, b) { return len(sub(a, b)); }\n\n  // 尖顶六边形顶点（顺时针：上、右上、右下、下、左下、左上）\n  function hexVertices(cx, cy, R) {\n    var v = [];\n    for (var i = 0; i < 6; i++) {\n      var a = (-90 + 60 * i) * Math.PI / 180;\n      v.push({ x: cx + R * Math.cos(a), y: cy + R * Math.sin(a) });\n    }\n    return v;\n  }\n\n  // 6 个顶点 + 共享半径 → 直线 + 圆弧\n  function shellPath(s) {\n    var v = hexVertices(s.cx, s.cy, s.R);\n    var d = s.radius / Math.tan(Math.PI / 3);   // 内角 120°：切点距顶点 r / tan(60°)\n    var parts = [];\n    for (var i = 0; i < 6; i++) {\n      var V = v[i], P = v[(i + 5) % 6], N = v[(i + 1) % 6];\n      var t1 = add(V, mul(unit(sub(P, V)), d));\n      var t2 = add(V, mul(unit(sub(N, V)), d));\n      parts.push((i === 0 ? 'M' : 'L') + f(t1.x) + ' ' + f(t1.y));\n      parts.push('A' + f(s.radius) + ' ' + f(s.radius) + ' 0 0 1 ' + f(t2.x) + ' ' + f(t2.y));\n    }\n    return parts.join(' ') + ' Z';\n  }\n\n  // 圆角六边形 = 内缩六边形 ⊕ 半径 r 的圆盘；据此求点到外壳边缘的精确距离\n  function innerHex(s) {\n    var apo = s.R * Math.cos(Math.PI / 6) - s.radius;\n    return hexVertices(s.cx, s.cy, apo / Math.cos(Math.PI / 6));\n  }\n  function segDist(p, a, b) {\n    var ab = sub(b, a), t = ((p.x - a.x) * ab.x + (p.y - a.y) * ab.y) / (ab.x * ab.x + ab.y * ab.y);\n    t = Math.max(0, Math.min(1, t));\n    return dist(p, add(a, mul(ab, t)));\n  }\n  function signedDistConvex(p, poly) {\n    var inside = true, m = Infinity;\n    for (var i = 0; i < poly.length; i++) {\n      var a = poly[i], b = poly[(i + 1) % poly.length];\n      var cross = (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);\n      if (cross < 0) inside = false;\n      m = Math.min(m, segDist(p, a, b));\n    }\n    return inside ? -m : m;\n  }\n  function clearance(p, s, inner) { return s.radius - signedDistConvex(p, inner); }\n\n  /* ---------- 统一几何函数（预览与导出共用） ---------- */\n  function computeGeometry(v) {\n    var w = v.strokeWidth, L = v.length, h = w / 2;\n    var rad = BASE.angleDeg * Math.PI / 180;\n    var E = { x: BASE.elbow.x, y: BASE.elbow.y };\n    var uV = { x: 0, y: -1 };                               // 竖臂方向\n    var uD = { x: Math.cos(rad), y: Math.sin(rad) };        // 斜臂方向\n    var A = add(E, mul(uV, L));                             // 竖臂端点\n    var B = add(E, mul(uD, L));                             // 斜臂端点（同一 length）\n    var canvas = v.canvas || BASE.canvas;\n    var vb = [SHELL.cx - canvas / 2, SHELL.cy - canvas / 2, canvas, canvas];\n\n    // L 外轮廓采样点（凸部件的外包点）\n    var pts = [];\n    function circle(c) { for (var i = 0; i < 36; i++) { var a = i * Math.PI / 18; pts.push({ x: c.x + h * Math.cos(a), y: c.y + h * Math.sin(a) }); } }\n    [[A, uV], [B, uD]].forEach(function (arm) {\n      var n = { x: -arm[1].y, y: arm[1].x };\n      if (v.cap === 'round') circle(arm[0]);\n      else { pts.push(add(arm[0], mul(n, h)), add(arm[0], mul(n, -h))); }\n      pts.push(add(E, mul(n, h)), add(E, mul(n, -h)));\n    });\n    var bis = unit(add(uV, uD));\n    var halfAngle = Math.acos(uV.x * uD.x + uV.y * uD.y) / 2;\n    if (v.join === 'round') circle(E);\n    else pts.push(add(E, mul(bis, -h / Math.sin(halfAngle))));  // 斜接尖点\n    var inner = innerHex(SHELL);\n    var minClear = Infinity;\n    pts.forEach(function (p) { minClear = Math.min(minClear, clearance(p, SHELL, inner)); });\n\n    // 外壳右下边方向（下顶点 → 右下顶点）\n    var hv = hexVertices(SHELL.cx, SHELL.cy, SHELL.R);\n    var edgeDeg = Math.atan2(hv[2].y - hv[3].y, hv[2].x - hv[3].x) * 180 / Math.PI;\n\n    return {\n      key: v.key, name: v.name,\n      params: { strokeWidth: w, length: L, cap: v.cap, join: v.join, canvas: canvas, elbow: E, angleDeg: BASE.angleDeg },\n      viewBox: vb.map(f).join(' '),\n      shellD: shellPath(SHELL),\n      lD: 'M' + f(A.x) + ' ' + f(A.y) + ' L' + f(E.x) + ' ' + f(E.y) + ' L' + f(B.x) + ' ' + f(B.y),\n      points: { verticalEnd: A, elbow: E, diagonalEnd: B },\n      armAngleDeg: halfAngle * 2 * 180 / Math.PI,\n      shellEdgeDeg: edgeDeg,\n      minClearance: minClear,\n      maskRect: vb\n    };\n  }\n\n  function buildSvg(v, idPrefix) {\n    var g = computeGeometry(v);\n    var id = idPrefix + '-mask';\n    var r = g.maskRect;\n    return '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"' + g.viewBox + '\" role=\"img\" aria-label=\"LeiBox ' + g.name + '\">' +\n      '<title>LeiBox</title>' +\n      '<defs><mask id=\"' + id + '\" maskUnits=\"userSpaceOnUse\" x=\"' + f(r[0]) + '\" y=\"' + f(r[1]) + '\" width=\"' + f(r[2]) + '\" height=\"' + f(r[3]) + '\">' +\n        '<rect x=\"' + f(r[0]) + '\" y=\"' + f(r[1]) + '\" width=\"' + f(r[2]) + '\" height=\"' + f(r[3]) + '\" fill=\"#fff\"/>' +\n        '<path data-role=\"l-centerline\" d=\"' + g.lD + '\" fill=\"none\" stroke=\"#000\" stroke-width=\"' + f(v.strokeWidth) + '\" stroke-linecap=\"' + v.cap + '\" stroke-linejoin=\"' + v.join + '\" stroke-miterlimit=\"4\"/>' +\n      '</mask></defs>' +\n      '<path d=\"' + g.shellD + '\" fill=\"#000\" mask=\"url(#' + id + ')\"/>' +\n      '</svg>';\n  }\n\n  // 从最终写入的 path d 中回读坐标并测量（不使用中间值）\n  function measureFromD(d) {\n    var n = d.match(/-?\\d+(\\.\\d+)?/g).map(Number);\n    var A = { x: n[0], y: n[1] }, E = { x: n[2], y: n[3] }, B = { x: n[4], y: n[5] };\n    return { vertical: dist(A, E), diagonal: dist(E, B), A: A, E: E, B: B };\n  }\n\n  /* ---------- 断言 ---------- */\n  var results = [];\n  var allPass = true;\n\n  VARIANTS.forEach(function (v) {\n    var g = computeGeometry(v);\n    var m = measureFromD(g.lD);\n    var exportSvg = buildSvg(v, 'leibox-' + v.key);\n    var previewSvg = buildSvg(v, 'p-' + v.key);\n    var checks = {\n      lengthEqual: Math.abs(m.vertical - m.diagonal) < 1e-2 && Math.abs(m.vertical / m.diagonal - 1) < 1e-4,\n      lengthMatchesParam: Math.abs(m.vertical - v.length) < 1e-2 && Math.abs(m.diagonal - v.length) < 1e-2,\n      singleStrokeWidth: (exportSvg.match(/stroke-width=\"/g) || []).length === 1,\n      verticalArmVertical: Math.abs(m.A.x - m.E.x) < EPS && m.A.y < m.E.y,\n      diagonalAngle: Math.abs(Math.atan2(m.B.y - m.E.y, m.B.x - m.E.x) * 180 / Math.PI - BASE.angleDeg) < 1e-2,\n      followsShellEdge: Math.abs(g.shellEdgeDeg - BASE.angleDeg) < 1e-9,\n      continuousJoint: /^M[^ML]+ L[^ML]+ L[^ML]+$/.test(g.lD),\n      insideShell: g.minClearance >= BASE.minClearance,\n      previewEqualsExport: previewSvg.split('p-' + v.key).join('X') === exportSvg.split('leibox-' + v.key).join('X')\n    };\n    var pass = Object.keys(checks).every(function (k) { return checks[k]; });\n    Object.keys(checks).forEach(function (k) { console.assert(checks[k], v.key + ' 断言失败: ' + k); });\n    if (!pass) allPass = false;\n    results.push({\n      key: v.key, name: v.name, params: g.params,\n      viewBox: g.viewBox, shellD: g.shellD, lD: g.lD,\n      points: g.points,\n      measured: { verticalLength: m.vertical, diagonalLength: m.diagonal, ratio: m.vertical / m.diagonal, strokeWidthVertical: v.strokeWidth, strokeWidthDiagonal: v.strokeWidth, widthRatio: 1 },\n      armAngleDeg: g.armAngleDeg,\n      minClearance: g.minClearance,\n      screen: null,\n      checks: checks,\n      pass: pass,\n      svg: exportSvg\n    });\n  });\n\n  window.logoGeometry = {\n    shell: SHELL,\n    base: BASE,\n    variants: results,\n    allPass: allPass,\n    buildSvg: function (key) { var v = VARIANTS.filter(function (x) { return x.key === key; })[0]; return v ? buildSvg(v, 'leibox-' + v.key) : null; }\n  };\n\n  /* ---------- 渲染 ---------- */\n  var grid = document.getElementById('grid');\n  var SIZES = [24, 48, 96];\n\n  VARIANTS.forEach(function (v, i) {\n    var r = results[i];\n    var card = document.createElement('article');\n    card.className = 'card';\n    card.setAttribute('aria-labelledby', 'title-' + v.key);\n    var sizesHtml = SIZES.map(function (s) {\n      return '<div class=\"size\"><div style=\"width:' + s + 'px;height:' + s + 'px\" data-size=\"' + s + '\">' +\n        buildSvg(v, 'p-' + v.key + '-' + s).replace('<svg ', '<svg width=\"' + s + '\" height=\"' + s + '\" ') +\n        '</div><span>' + s + 'px</span></div>';\n    }).join('');\n    card.innerHTML =\n      '<div class=\"card-head\"><h2 id=\"title-' + v.key + '\">' + v.name + '</h2><span class=\"idx\">' + v.key.slice(0, 2) + '</span></div>' +\n      '<p class=\"spec\">线宽 ' + v.strokeWidth + ' · 臂长 ' + v.length + ' · ' + CAP_LABEL[v.cap] + ' · ' + JOIN_LABEL[v.join] + (v.canvas ? ' · 留白收紧' : '') + '</p>' +\n      '<div class=\"stage main-preview\">' + buildSvg(v, 'p-' + v.key) + '</div>' +\n      '<div class=\"stage sizes\" aria-label=\"使用尺寸预览\">' + sizesHtml + '</div>' +\n      '<dl class=\"measure\">' +\n        '<dt>竖臂长度</dt><dd>' + r.measured.verticalLength.toFixed(3) + '</dd>' +\n        '<dt>斜臂长度</dt><dd>' + r.measured.diagonalLength.toFixed(3) + '</dd>' +\n        '<dt>长度比</dt><dd>' + r.measured.ratio.toFixed(4) + ' : 1</dd>' +\n        '<dt>宽度比</dt><dd>' + v.strokeWidth + ' / ' + v.strokeWidth + ' = 1 : 1</dd>' +\n        '<dt>屏幕测量</dt><dd data-screen>—</dd>' +\n        '<dt>距外壳最小间距</dt><dd>' + r.minClearance.toFixed(1) + '</dd>' +\n      '</dl>' +\n      '<div class=\"card-foot\"><span class=\"check ' + (r.pass ? 'ok' : 'bad') + '\">' + (r.pass ? '✓ 几何校验通过' : '✗ 几何校验未通过') + '</span>' +\n      '<button type=\"button\" data-download=\"' + v.key + '\">下载 SVG</button></div>';\n    grid.appendChild(card);\n  });\n\n  // 最终屏幕坐标测量：用主预览 svg 的 CTM 变换三个点\n  function measureScreen() {\n    var ok = true;\n    results.forEach(function (r) {\n      var svg = grid.querySelector('#title-' + r.key).closest('.card').querySelector('.main-preview svg');\n      var path = svg.querySelector('[data-role=\"l-centerline\"]');\n      var ctm = svg.getScreenCTM();\n      var cell = grid.querySelector('#title-' + r.key).closest('.card').querySelector('[data-screen]');\n      if (!ctm) { cell.textContent = '不可用'; return; }\n      var m = measureFromD(path.getAttribute('d'));\n      function tp(p) { var q = svg.createSVGPoint(); q.x = p.x; q.y = p.y; return q.matrixTransform(ctm); }\n      var A = tp(m.A), E = tp(m.E), B = tp(m.B);\n      var sv = Math.hypot(A.x - E.x, A.y - E.y), sd = Math.hypot(B.x - E.x, B.y - E.y);\n      var total = null;\n      try { total = path.getTotalLength(); } catch (e) { total = null; }\n      r.screen = { verticalPx: sv, diagonalPx: sd, ratio: sv / sd, pathTotalLength: total, strokeWidthPx: r.params.strokeWidth * ctm.a };\n      var pass = Math.abs(sv / sd - 1) < 1e-3 && (total === null || Math.abs(total - 2 * r.params.length) < 0.05);\n      r.checks.screenEqual = pass;\n      console.assert(pass, r.key + ' 断言失败: screenEqual');\n      if (!pass) { r.pass = false; ok = false; }\n      cell.textContent = sv.toFixed(2) + ' / ' + sd.toFixed(2) + ' px';\n    });\n    window.logoGeometry.allPass = window.logoGeometry.allPass && ok;\n    var st = document.getElementById('globalStatus');\n    st.className = 'status ' + (window.logoGeometry.allPass ? 'ok' : 'bad');\n    st.textContent = window.logoGeometry.allPass ? '6 款几何断言全部通过' : '有方案几何断言未通过，详见控制台';\n  }\n  requestAnimationFrame(function () { requestAnimationFrame(measureScreen); });\n\n  /* ---------- 交互 ---------- */\n  grid.addEventListener('click', function (e) {\n    var btn = e.target.closest('[data-download]');\n    if (!btn) return;\n    var key = btn.getAttribute('data-download');\n    var svg = '<?xml version=\"1.0\" encoding=\"UTF-8\"?>\\n' + window.logoGeometry.buildSvg(key) + '\\n';\n    var url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));\n    var a = document.createElement('a');\n    a.href = url;\n    a.download = 'leibox-logo-' + key + '.svg';\n    document.body.appendChild(a);\n    a.click();\n    a.remove();\n    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);\n  });\n\n  var bgButtons = document.querySelectorAll('[data-bg]');\n  bgButtons.forEach(function (b) {\n    b.addEventListener('click', function () {\n      document.body.className = 'bg-' + b.getAttribute('data-bg');\n      bgButtons.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });\n    });\n  });\n})();\n</script>\n</body>\n</html>\n"
  }
